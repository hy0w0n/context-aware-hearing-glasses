<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="20dp">

    <TextView android:id="@+id/tvResult"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:text="버튼을 눌러 녹음을 시작하세요."
        android:textSize="20sp" android:gravity="center" />

    <Button android:id="@+id/btnRecord"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="녹음 시작" android:textSize="24sp" android:padding="20dp"/>
</LinearLayout>